# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=change-this-in-production

# Database
DATABASE_URL=sqlite:///./data/instagram.db

# Storage Provider (Phase E) - "supabase" | "r2" | "s3" | "local"
STORAGE_PROVIDER=supabase

# Supabase Storage Configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=instagram-carousels

# Alternative Cloudflare R2 / S3 Storage
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=instagram-carousels
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# Make.com Scenario Integration (Phase G)
MAKE_API_URL=https://hook.eu1.make.com/your-webhook-url
MAKE_API_TOKEN=
MAKE_SCENARIO_ID=

# Image Processing Configuration (Phase D)
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
MAX_IMAGES_PER_CAROUSEL=10
MAX_IMAGE_SIZE_MB=20
